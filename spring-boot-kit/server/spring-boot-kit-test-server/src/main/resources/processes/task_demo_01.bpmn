    <bpmn:sequenceFlow id="Flow_1h8uptf" sourceRef="Gateway_0zql2cc" targetRef="task_audit_sign_and">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${flowResultCode==7}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
