<?xml version="1.0" encoding="UTF-8" ?>
<configuration>

    <springProperty scope="context" name="springAppName" source="spring.application.name" defaultValue="unknown-sub-server"/>
    <springProperty scope="context" name="springAppEnv" source="spring.profiles.active" defaultValue="unknown-env"/>
    <property name="commonEncoderPattern" value="%date [%green(%-5level)] [%thread] [%cyan(%logger{80})] [%X{trace.id}] [%X{transaction.id}] [%X{error.id}] [%file : %line] %msg%n"/>
    <property name="LOG_HOME" value="${LOG_ROOT:-logs}/${springAppName}" />
<!--    <appender name="consoleLog" class="ch.qos.logback.core.ConsoleAppender">-->
<!--        <encoder class="ch.qos.logback.classic.encoder.PatternLayoutEncoder">-->
<!--            <pattern>${commonEncoderPattern}</pattern>-->
<!--            <charset>UTF-8</charset>-->
<!--        </encoder>-->
<!--    </appender>-->
    <appender name="consoleLog" class="springbootkit.desensitization.support.logback.appender.DesensitizedConsoleAppender">
        <encoder class="ch.qos.logback.classic.encoder.PatternLayoutEncoder">
            <pattern>${commonEncoderPattern}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <appender name="DST_LOG"
              class="springbootkit.desensitization.support.logback.appender.DesensitizedRollingFileAppender">
        <File>${LOG_HOME}/desensitized.log</File>
        <rollingPolicy
                class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <!-- 每天一归档 -->
            <fileNamePattern>${LOG_HOME}/desensitized-%d{yyyyMMdd}.log.%i
            </fileNamePattern>
            <!-- 单个日志文件最多50MB, 30天的日志周期，最大不能超过500MB -->
            <maxFileSize>50MB</maxFileSize>
            <maxHistory>30</maxHistory>
            <totalSizeCap>500MB</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <pattern>${commonEncoderPattern}</pattern>
        </encoder>
    </appender>

    <logger name="DST_LOG" level="INFO" additivity="false">
        <appender-ref ref="DST_LOG" />
    </logger>

    <appender name="LOGSTASH" class="net.logstash.logback.appender.LogstashTcpSocketAppender">
        <destination>192.0.2.1:9250,192.0.2.1:9251</destination>
        <queueSize>1048576</queueSize>
        <encoder charset="UTF-8" class="net.logstash.logback.encoder.LoggingEventCompositeJsonEncoder">
            <providers class="net.logstash.logback.composite.loggingevent.LoggingEventJsonProviders">
                <timestamp>
                    <timeZone>UTC</timeZone>
                </timestamp>
                <pattern>
                    <pattern>
                        {
                        "server_date":"%date{yyyy-MM-dd HH:mm:ss.SSS}",
                        "app_name":"${springAppName}",
                        "service_name": "spring-boot-kit-${springAppEnv}-%date{yyyyMM}",
                        "file_line":"%file:%line",
                        "port":"${port}",
                        "level": "%level",
                        "thread": "%thread",
                        "class": "%logger{40}",
                        "message": "%message",
                        "stack_trace": "%exception",
                        "trace.id":"%mdc{trace.id}",
                        "transaction.id":"%mdc{transaction.id}",
                        "error.id":"%mdc{error.id}"
                        }
                    </pattern>
                </pattern>
            </providers>
        </encoder>
    </appender>

    <root level="info">
        <!--颜色管理-->
        <appender-ref ref="consoleLog"/>
        <appender-ref ref="LOGSTASH"/>
<!--        <appender-ref ref="DST_LOG"/>-->
    </root>

</configuration>