<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>io.github.jevonsnotes</groupId>
        <artifactId>jevokit-parent</artifactId>
        <version>3.5.2.1</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <groupId>io.github.jevonsnotes</groupId>
    <artifactId>jevokit-sample</artifactId>
    <name>jevokit-sample</name>
    <description>Demo project for Spring Boot</description>
    <properties>
        <!-- 示例应用不发布仓库（开源惯例：sample 不进 deploy）；本地 install 供 -pl 单模块联调用 -->
        <maven.deploy.skip>true</maven.deploy.skip>
        <!-- E2E 分层（surefire excludedGroups 参数绑定）：默认构建仅排除 @Tag("mq") 的
             RocketMqE2ETest（唯一真依赖 MQ 的用例——需 9876 nameserver）。
             其余 8 个 E2E 类属默认测试集：内建 @ActiveProfiles("local") 排除 MQ 自动装配，
             环境仅需 Redis 在位（H2 内存自给）——默认套件本就依赖 Redis（ApplicationTest
             token 往返），故未抬高默认门槛，只是把"有 Redis 就能跑的 E2E"变为默认。
             跑法：
               - 默认（Redis 在位即可）：mvn test            → 冒烟 + 8 个非 MQ E2E
               - 全量（含 RocketMQ）：    mvn test -DexcludedGroups=
             （用户属性 -D 覆盖本处 project 属性；excludedGroups= 空串等于不排除） -->
        <excludedGroups>mq</excludedGroups>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>io.github.jevonsnotes</groupId>
            <artifactId>jevokit-security-all-spring-boot-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.jevonsnotes</groupId>
            <artifactId>jevokit-audit-log-spring-boot-starter</artifactId>
        </dependency>
        <!-- junit:junit 已于终验 #6 移除：防线类已迁 JUnit5，全仓 JUnit4 API 零残留 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.jevonsnotes</groupId>
            <artifactId>jevokit-excel-spring-boot-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.jevonsnotes</groupId>
            <artifactId>jevokit-desensitization-spring-boot-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.jevonsnotes</groupId>
            <artifactId>jevokit-redis-spring-boot-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.jevonsnotes</groupId>
            <artifactId>jevokit-nogen-spring-boot-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.jevonsnotes</groupId>
            <artifactId>jevokit-workflow-spring-boot-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.jevonsnotes</groupId>
            <artifactId>jevokit-jasypt-spring-boot-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.jevonsnotes</groupId>
            <artifactId>jevokit-rocketmq-spring-boot-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.jevonsnotes</groupId>
            <artifactId>jevokit-okhttp-spring-boot-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.jevonsnotes</groupId>
            <artifactId>jevokit-api-spring-boot-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>ch.qos.logback</groupId>
            <artifactId>logback-classic</artifactId>
        </dependency>
        <!-- https://mvnrepository.com/artifact/org.apache.cxf/cxf-spring-boot-starter-jaxrs -->
        <dependency>
            <groupId>org.apache.cxf</groupId>
            <artifactId>cxf-spring-boot-starter-jaxws</artifactId>
            <version>4.1.2</version>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- BOM 合并改造配套：Boot parent 的 pluginManagement 已绑定 repackage execution
                 （无需本处再声明 executions，重复声明不同 id 会导致 repackage 双执行）；
                 同时其默认 mainClass=${spring-boot.run.main-class}→${start-class} 在本模块未定义
                 start-class 属性时会以未解析字面量写入 MANIFEST，java -jar 直接失败
                 （原无 Boot parent 时 mainClass 留空、插件自动扫描唯一 main 方法——行为需显式回归）。
                 故显式钉定主类。 -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <mainClass>io.github.jevonsnotes.jevokit.sample.JevokitSampleApplication</mainClass>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-deploy-plugin</artifactId>
                <configuration>
                    <skip>true</skip>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
