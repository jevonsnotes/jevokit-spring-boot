    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>io.github.jevonsnotes</groupId>
                <artifactId>jevokit-dependencies</artifactId>
                <version>${project.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>
    <dependencies>

        <dependency>
            <!-- this is needed or IntelliJ gives junit.jar or junit-platform-launcher:1.3.2 not found errors -->
            <groupId>org.junit.platform</groupId>
            <artifactId>junit-platform-launcher</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- junit-vintage-engine 已于终验 #6 移除：存量 JUnit4 测试（防线类两枚）已全部迁 JUnit5，
             全仓 org.junit.Test/@RunWith/org.junit.Assert 零残留（grep 验证）。若未来误引 JUnit4 API，
             在 junit-platform-launcher 在位的 surefire JUnitPlatformProvider 下会被静默跳过
             （Tests run: 0 陷阱）——新增测试一律 JUnit5（jupiter）+ AssertJ。 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-configuration-processor</artifactId>
            <optional>true</optional>
        </dependency>
    </dependencies>
    <build>
        <pluginManagement>
            <plugins>
                <!-- 钉定 spring-boot-maven-plugin 版本，与 BOM（jevokit-dependencies）父级
                     spring-boot-starter-parent 3.5.16 基线一致。
                     本工程对 BOM 仅为 import scope（只传递 dependencyManagement，不传递 pluginManagement），
                     且本 pom 无 Maven parent，插件若不钉版本，Maven 会解析仓库 metadata 的 <release>
                     （当前为 4.2.0-M1 里程碑），导致 repackage 插件与依赖基线分叉、构建不可复现。
                     存量缺陷修复，非重命名重构引入。 -->
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                    <version>3.5.16</version>
                </plugin>
                <!-- 钉定 maven-compiler-plugin 版本：本 pom 无 Maven parent，插件无版本声明时
                     回落到 Maven 内置编译插件（3.1，过旧），<parameters>true</parameters> 被静默
                     忽略，字节码不携带 MethodParameters 属性，Spring Boot 3.2+ 的隐式参数名
                     绑定全部失效（运行期 500）。3.13.0 取自本 pom 原注释中的预留版本。
                     存量缺陷修复，非重命名重构引入。 -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.13.0</version>
                </plugin>
                <!-- 钉定 maven-surefire-plugin 版本：与 spring-boot-starter-parent 3.5.16 管理的
                     版本一致（其 maven-surefire-plugin.version=3.5.6）。BOM 仅 import scope 不传递
                     pluginManagement，未钉版时 Maven 回落内置 surefire 2.12.4——不支持 JUnit5，
                     jupiter 测试类被静默跳过（Running 行都不出现）；且 2.12.4 无法与 junit-platform
                     混跑。测试基建（B 档测试重构阶段 0）统一入口。 -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>3.5.6</version>
                    <configuration>
                        <!-- 测试 JVM 统一 UTF-8（缺陷修复：Windows GBK 本机乱码）：
                             surefire fork 的测试 JVM 继承平台默认编码（本机 JDK17 file.encoding=GBK），
                             logback ConsoleAppender 走 System.out 按 GBK 编码中文，而 surefire
                             把 stdout 原样字节写入声明 UTF-8 的 TEST-*.xml 报告 → 报告乱码
                             （张*丰 变 寮?*涓?）。故在测试 JVM 上强制：
                               -Dfile.encoding=UTF-8           覆盖默认字符集（JDK17 默认仍随平台）
                               -Dstdout/stderr.encoding=UTF-8  JDK19+ 属性，JDK17 忽略，向前兼容
                             注意：直接写死 argLine 会覆盖 jacoco prepare-agent 设置的 @{argLine}
                             javaagent 行（覆盖率静默失效），必须用 @{argLine} 延迟替换保留；
                             父 pom properties 已给 argLine 空默认值，jacoco 未激活时不出
                             "@{argLine}" 字面量 JVM 启动错误。
                             同根因家族（平台默认字符集依赖）见教训：
                             getBytes 默认编码跨平台。 -->
                        <argLine>@{argLine} -Dfile.encoding=UTF-8 -Dstdout.encoding=UTF-8 -Dstderr.encoding=UTF-8</argLine>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
        <plugins>
            <!--     版本管理插件       -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>versions-maven-plugin</artifactId>
<!--                <version>${versions-maven-plugin.version}</version>-->
                <configuration>
                    <generateBackupPoms>false</generateBackupPoms>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
<!--                <version>${spring-boot-maven-plugin.version}</version>-->
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-deploy-plugin</artifactId>
<!--                <version>${maven-deploy-plugin.version}</version>-->
                <configuration>
                    <skip>true</skip>
                </configuration>
            </plugin>

            <!--            打包依赖的插件 有需要时取消注释-->
            <!--            <plugin>-->
            <!--                <groupId>org.apache.maven.plugins</groupId>-->
            <!--                <artifactId>maven-dependency-plugin</artifactId>-->
            <!--                <executions>-->
            <!--                    <execution>-->
            <!--                        <id>copy-dependencies</id>-->
            <!--                        <phase>package</phase>-->
            <!--                        <goals>-->
            <!--                            <goal>copy-dependencies</goal>-->
            <!--                        </goals>-->
            <!--                        <configuration>-->
            <!--                            <outputDirectory>-->
            <!--                                ${project.build.directory}/lib/-->
            <!--                            </outputDirectory>-->
            <!--                        </configuration>-->
            <!--                    </execution>-->
            <!--                </executions>-->
            <!--            </plugin>-->
            <plugin>
                <artifactId>maven-compiler-plugin</artifactId>
<!--                <version>${maven-compiler-plugin.version}</version>-->
                <configuration>
                    <source>17</source>
                    <target>17</target>
                    <!-- 指明编译源代码时使用的字符编码，
                    maven编译的时候默认使用的GBK编码，
                      通过encoding属性设置字符编码，
                      告诉maven这个项目使用UTF-8来编译 -->
                    <encoding>utf8</encoding>
                    <!--        使用方法真实名称            -->
                    <parameters>true</parameters>
                </configuration>
            </plugin>
            <!-- 测试覆盖率采集（B 档测试重构阶段 0）：prepare-agent 在初始化阶段挂 javaagent，
                 report 绑 verify 阶段出 target/site/jacoco/index.html。本阶段只出报告，
                 rule/limit 门槛留给终验阶段（避免补测中途被覆盖率闸门卡断）。 -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>0.8.12</version>
                <executions>
                    <execution>
                        <id>prepare-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <!-- Central 发布配套（#11）：source/javadoc 附加构件，日常 package 即产出。
                 版本钉定（本 pom 无 Maven parent，插件不钉版会回落仓库 metadata）；
                 javadoc doclint 关闭——存量注释不规整不拦发布，仅语法级硬错误会失败（需修）。 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-source-plugin</artifactId>
                <version>3.3.1</version>
                <executions>
                    <execution>
                        <id>attach-sources</id>
                        <goals>
                            <goal>jar-no-fork</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-javadoc-plugin</artifactId>
                <version>3.11.3</version>
                <configuration>
                    <doclint>none</doclint>
                </configuration>
                <executions>
                    <execution>
                        <id>attach-javadocs</id>
                        <goals>
                            <goal>jar</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <!-- Central 发布（#11）：签名与发布仅 release profile 激活（-Prelease），
         日常构建零签名零发布开销。gpg 口令取 settings.xml 的 gpg.passphrase server；
         sample 模块 maven.deploy.skip=true 会同时抑制 central-publishing（不发布示例应用）。 -->
    <profiles>
        <profile>
            <id>release</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-gpg-plugin</artifactId>
                        <version>3.2.7</version>
                        <configuration>
                            <keyname>71080C224E332E21</keyname>
                        </configuration>
                        <executions>
                            <execution>
                                <id>sign-artifacts</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>sign</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.sonatype.central</groupId>
                        <artifactId>central-publishing-maven-plugin</artifactId>
                        <version>0.8.0</version>
                        <!-- extensions=true：接管 deploy 生命周期（官方要求），否则 publish 目标不绑定、上传静默跳过 -->
                        <extensions>true</extensions>
                        <configuration>
                            <publishingServerId>central</publishingServerId>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

</project>