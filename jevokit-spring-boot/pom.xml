    <properties>
        <!-- 统一编码声明：compiler/javadoc/source 等插件默认读取（javadoc fork 场景下比插件参数更稳） -->
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <!-- argLine 空默认值：jacoco prepare-agent 会设置 argLine 传 javaagent 给 surefire；
             此处空默认确保 jacoco 未激活时 @{argLine} 延迟替换不出字面量错误 -->
        <argLine></argLine>
<!--        <maven-compiler-plugin.version>3.13.0</maven-compiler-plugin.version>-->
<!--        <maven-deploy-plugin.version>2.8.2</maven-deploy-plugin.version>-->
<!--        <versions-maven-plugin.version>2.8.1</versions-maven-plugin.version>-->
<!--        <spring-boot-maven-plugin.version>2.7.18</spring-boot-maven-plugin.version>-->
    </properties>
    <modules>
        <!-- 聚合器扁平化（#12）：原 common/others/security/audit 三层聚合器已删，19 模块直挂 -->
