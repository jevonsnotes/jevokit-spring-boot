            <!--                            </outputDirectory>-->
            <!--                        </configuration>-->
            <!--                    </execution>-->
            <!--                </executions>-->
            <!--            </plugin>-->
            <!-- 测试覆盖率采集（B 档测试重构阶段 0）：prepare-agent 在初始化阶段挂 javaagent，
                 report 绑 verify 阶段出 target/site/jacoco/index.html。本阶段只出报告，
                 rule/limit 门槛留给终验阶段（避免补测中途被覆盖率闸门卡断）。 -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>0.8.12</version>
                <executions>
                    <execution>
                        <id>prepare-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <!-- Central 发布配套（#11）：source/javadoc 附加构件，日常 package 即产出。
                 版本钉定（Boot parent 不管理此二插件，不钉版会回落仓库 metadata）；
                 javadoc doclint 关闭——存量注释不规整不拦发布，仅语法级硬错误会失败（需修）。 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-source-plugin</artifactId>
                <version>3.3.1</version>
                <executions>
                    <execution>
                        <id>attach-sources</id>
                        <goals>
                            <goal>jar-no-fork</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-javadoc-plugin</artifactId>
                <version>3.11.3</version>
                <configuration>
                    <doclint>none</doclint>
                </configuration>
                <executions>
                    <execution>
                        <id>attach-javadocs</id>
                        <goals>
                            <goal>jar</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <!-- Central 发布（#11）：签名与发布仅 release profile 激活（-Prelease），
         日常构建零签名零发布开销。gpg 口令取 settings.xml 的 gpg.passphrase server；
         sample 不发布由 release profile 的 excludeArtifacts 按 artifactId 常驻排除
         （0.8.0 不读取 maven.deploy.skip，该属性仅抑制 maven-deploy-plugin；
         -pl '!sample/jevokit-sample' 可保留作双保险，与 excludeArtifacts 兼容不冲突）；
         BOM 薄壳（jevokit-dependencies）经本 profile 一并签名发布——单 reactor 单 deployment。 -->
    <profiles>
        <profile>
            <id>release</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-gpg-plugin</artifactId>
                        <version>3.2.7</version>
                        <configuration>
                            <keyname>71080C224E332E21</keyname>
                        </configuration>
                        <executions>
                            <execution>
                                <id>sign-artifacts</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>sign</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.sonatype.central</groupId>
                        <artifactId>central-publishing-maven-plugin</artifactId>
                        <version>0.8.0</version>
                        <!-- extensions=true：接管 deploy 生命周期（官方要求），否则 publish 目标不绑定、上传静默跳过 -->
                        <extensions>true</extensions>
                        <configuration>
                            <publishingServerId>central</publishingServerId>
                            <!-- sample 按 artifactId 常驻排除出 bundle（0.8.0 原生参数，release/SNAPSHOT
                                 双路径过滤；sources/javadoc/pom 与主构件同 artifactId 一并剔除，双路径干跑
                                 实证）：发布命令无需 -pl 排除 sample，保留 -pl 仅作双保险（与参数兼容不冲突） -->
                            <excludeArtifacts>
                                <excludeArtifacts>jevokit-sample</excludeArtifacts>
                            </excludeArtifacts>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

</project>
