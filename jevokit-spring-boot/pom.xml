        <module>core/jevokit-autoconfigure</module>
        <module>starter/security/jevokit-security-web-fixed</module>
        <module>starter/security/jevokit-security-xss</module>
        <module>starter/security/jevokit-security-path-traversal</module>
        <module>starter/security/jevokit-security-sql-inject</module>
        <module>starter/security/jevokit-security-code-inject</module>
        <module>starter/security/jevokit-security-all</module>
        <module>starter/security/jevokit-api</module>
        <module>starter/security/jevokit-jasypt</module>
        <module>starter/compliance/jevokit-desensitization</module>
        <module>starter/compliance/jevokit-audit-log</module>
        <module>starter/data/jevokit-redis</module>
        <module>starter/data/jevokit-nogen</module>
        <module>starter/data/jevokit-excel</module>
        <module>starter/integration/jevokit-rocketmq</module>
        <module>starter/integration/jevokit-okhttp</module>
        <module>starter/integration/jevokit-workflow</module>
